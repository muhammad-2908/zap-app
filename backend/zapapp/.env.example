# ---------------------------------------------------------------
# Zap App backend configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
# Extra browser origins allowed by CORS, comma-separated (FRONTEND_URL is always allowed). Optional.
CORS_ORIGINS=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# MongoDB (Atlas: Connect -> Drivers). Keep /zap-app as the database name.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/zap-app?retryWrites=true&w=majority

# GitHub OAuth App (GitHub -> Settings -> Developer settings -> OAuth Apps)
#   Homepage URL:               http://localhost:4200
#   Authorization callback URL: http://localhost:4200/api/auth/github/callback
GITHUB_CLIENT_ID=<oauth_app_client_id>
GITHUB_CLIENT_SECRET=<oauth_app_client_secret>
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4200/api/auth/github/callback

# Sessions and token encryption. Generate each value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=<random_base64_32_bytes>
TOKEN_ENCRYPTION_KEY=<random_base64_32_bytes>
# Session length in hours (default 8)
SESSION_TTL_HOURS=8

# Webhooks. GitHub posts pull request events to PUBLIC_WEBHOOK_URL (must be https and end with
# /api/webhooks/github); in development that is your ngrok static domain forwarding to port 3000:
#   ngrok http 3000 --url=https://<your-static-domain>.ngrok-free.app
# The app installs the webhook itself when a Zap is turned on; don't add one by hand.
NGROK_DOMAIN=<your-static-domain>.ngrok-free.app
PUBLIC_WEBHOOK_URL=https://<your-static-domain>.ngrok-free.app/api/webhooks/github
# Signs every delivery (HMAC-SHA256). Generate like the secrets above.
GITHUB_WEBHOOK_SECRET=<random_base64_32_bytes>

# --- Copilot (optional) ----------------------------------------

# OpenAI API key (platform.openai.com). Leave empty to use the rule-based Copilot.
OPENAI_API_KEY=
# Model id; empty = gpt-6-luna (fast and inexpensive). Any model that supports Structured Outputs works.
OPENAI_MODEL=
